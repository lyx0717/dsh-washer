{
  "name": "dsh-washer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "滚筒洗衣机 · 用一台洗衣机的运转状态显示 Agent 的工作状态",
  "icon": "./icon.svg",
  "main": "index.js",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "docs/*.png",
    "debug/overlay.html",
    "docs/overlay-float.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  }
}
